# CoolKit Environment Configuration
# Copy this file to .env and update values for your environment

# Server
SERVER_PORT=8080
GIN_MODE=debug

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=coolkit
DB_PASSWORD=coolkit
DB_NAME=coolkit
DB_SSLMODE=disable

# Authentication
JWT_SECRET=your-super-secret-key-change-in-production
